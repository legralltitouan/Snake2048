<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Snake2048" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/Snake2048" prefix_auto="1" extension_auto="1" />
				<Option working_dir="." />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option use_console_runner="1" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-Wextra" />
					<Add option="-std=c99" />
					<Add option="-g" />
				</Compiler>
				<Linker>
					<Add library="ncursesw" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/Snake2048" prefix_auto="1" extension_auto="1" />
				<Option working_dir="." />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option use_console_runner="1" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-Wall" />
					<Add option="-std=c99" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="ncursesw" />
				</Linker>
			</Target>
			<Target title="PDCurses_Windows">
				<Option output="bin/PDCurses/Snake2048" prefix_auto="1" extension_auto="1" />
				<Option working_dir="." />
				<Option object_output="obj/PDCurses/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option use_console_runner="1" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-Wextra" />
					<Add option="-std=c99" />
					<Add option="-DUSE_PDCURSES" />
					<Add option="-g" />
				</Compiler>
				<Linker>
					<Add library="pdcurses_wincon" />
					<Add library="winmm" />
				</Linker>
			</Target>
			<Target title="Linux_IUT">
				<Option output="bin/Linux/Snake2048" prefix_auto="1" extension_auto="1" />
				<Option working_dir="." />
				<Option object_output="obj/Linux/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option use_console_runner="1" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-Wextra" />
					<Add option="-std=c99" />
					<Add option="-g" />
				</Compiler>
				<Linker>
					<Add library="ncurses" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
		</Compiler>
		<Unit filename="affichage.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="affichage.h" />
		<Unit filename="console.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="console.h" />
